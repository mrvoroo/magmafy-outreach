# Names only — put real values in the server's secret store / .env (never commit).
NODE_ENV=production
DB_PATH=./data/outreach.sqlite
AUTH_STATE_DIR=./data/auth_state
BACKUP_DIR=./data/backups
LOG_LEVEL=info

# Safety switches (defaults are the SAFE ones)
SEND_ENABLED=false          # must be literally "true" for any real WhatsApp send
SEND_MODE=off               # off | assisted | auto   (can also be changed from Telegram)
AUTO_REPLY=off

# CRM door (Apps Script web app) — Section 6.9
CRM_URL=
CRM_OUTREACH_KEY=

# Google Places API (New)
GOOGLE_PLACES_API_KEY=
GOOGLE_DAILY_BUDGET_USD=
GOOGLE_MONTHLY_BUDGET_USD=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=

# Telegram control bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Admin page
ADMIN_PORT=8080
ADMIN_BASIC_TOKEN=          # OPTIONAL emergency/demo fallback (24+ chars). Normal sign-in = CRM admin e-mail + emailed code
BACKUP_PASSPHRASE=          # encrypts the WhatsApp auth-state backup
